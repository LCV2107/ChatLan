<Window x:Class="MiniChat.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MiniChat.App.Views"
        Title="MiniChat LAN" Width="380" Height="540" MinWidth="320" MinHeight="40"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="Assets/minichat.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ShowPeopleCommand}"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ShowChatCommand}"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding ShowSettingsCommand}"/>
    </Window.InputBindings>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado: zona de arrastre -->
            <Grid Grid.Row="0" Background="{DynamicResource Surface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Assets/minichat.ico" Width="16" Height="16" Margin="10,0,8,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MiniChat LAN" FontWeight="SemiBold" FontSize="12.5"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowMain, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="8" Padding="6,0" Margin="0,0,4,0" VerticalAlignment="Center"
                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" ToolTip="Mensajes sin leer">
                    <TextBlock Text="{Binding UnreadBadge}" Foreground="{StaticResource OnAccent}" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding ShowSettingsCommand}" Content="&#xE896;" Foreground="{StaticResource AccentHi}"
                        ToolTip="{Binding UpdateTooltip}" AutomationProperties.Name="Actualización disponible"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding LockNowCommand}" Content="&#xE72E;" ToolTip="Bloquear ahora (pedirá el PIN)" AutomationProperties.Name="Bloquear"
                        Visibility="{Binding ShowMain, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="5" x:Name="CollapseButton" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCollapseClick" ToolTip="Contraer / expandir" AutomationProperties.Name="Contraer o expandir">
                    <TextBlock x:Name="CollapseGlyph" Text="&#xE70E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextDim}"/>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource IconButton}" WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnHideClick" ToolTip="Ocultar (sigue funcionando en la bandeja del sistema)" AutomationProperties.Name="Ocultar"
                        Content="&#xE711;" Margin="0,0,4,0"/>
            </Grid>

            <!-- Navegación -->
            <StackPanel Grid.Row="1" x:Name="NavBar" Orientation="Horizontal" Margin="8,6,8,2"
                        Visibility="{Binding ShowMain, Converter={StaticResource BoolToVis}}">
                <RadioButton Style="{StaticResource NavTab}" IsChecked="{Binding IsPeople}" AutomationProperties.Name="Personas">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Personas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <Border Background="#F59E0B" CornerRadius="7" Padding="5,0" Margin="6,0,0,0"
                                Visibility="{Binding HasIncomingRequests, Converter={StaticResource BoolToVis}}" ToolTip="Solicitudes pendientes">
                            <TextBlock Text="{Binding IncomingRequests}" Foreground="#1E1F22" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavTab}" IsChecked="{Binding IsChat}" AutomationProperties.Name="Conversación">
                    <TextBlock Text="Conversación" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
                <RadioButton Style="{StaticResource NavTab}" IsChecked="{Binding IsSettings}" AutomationProperties.Name="Ajustes">
                    <TextBlock Text="Ajustes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                </RadioButton>
            </StackPanel>

            <!-- Error global -->
            <Border Grid.Row="2" Background="{StaticResource DangerBg}" CornerRadius="6" Margin="8,4,8,0" Padding="8,6"
                    Visibility="{Binding HasGlobalError, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissErrorCommand}" ToolTip="Cerrar aviso"/>
                    <TextBlock Text="{Binding GlobalError}" Style="{StaticResource ErrorText}"/>
                </DockPanel>
            </Border>

            <!-- Contenido -->
            <Grid Grid.Row="3" x:Name="ContentArea" Margin="8,4,8,8">
                <views:OnboardingView Visibility="{Binding Onboarding, Converter={StaticResource BoolToVis}}"/>
                <views:LockView Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}"/>
                <Grid Visibility="{Binding ShowMain, Converter={StaticResource BoolToVis}}">
                    <views:PeopleView DataContext="{Binding People}" Visibility="{Binding DataContext.IsPeople, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:ChatView x:Name="ChatView" DataContext="{Binding Chat}" Visibility="{Binding DataContext.IsChat, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:SettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
