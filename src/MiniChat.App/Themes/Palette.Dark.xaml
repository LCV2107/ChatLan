<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Paleta OSCURA (azul/negro moderno). Solo colores; los brushes y estilos viven en Theme.xaml y los
      referencian con DynamicResource, de modo que cambiar de paleta en caliente actualiza toda la interfaz.
      Contraste de texto principal ≥ 12:1 y secundario ≥ 4.5:1 sobre el fondo.
    -->
    <Color x:Key="BgColor">#0F141B</Color>
    <Color x:Key="SurfaceColor">#161D26</Color>
    <Color x:Key="SurfaceHiColor">#202A36</Color>
    <Color x:Key="BorderColor">#2C3744</Color>
    <Color x:Key="TextColor">#EAF0F6</Color>
    <Color x:Key="TextDimColor">#97A3B3</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHiColor">#60A5FA</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="DangerBgColor">#3A2326</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>
    <Color x:Key="WarnBgColor">#3A3023</Color>
    <Color x:Key="OnlineColor">#4ADE80</Color>
    <Color x:Key="OfflineColor">#6B7280</Color>
    <Color x:Key="BubbleOutColor">#1E3A5F</Color>
    <Color x:Key="BubbleInColor">#1E2630</Color>
    <Color x:Key="ScrollThumbColor">#55FFFFFF</Color>
</ResourceDictionary>
