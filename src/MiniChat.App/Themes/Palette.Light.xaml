<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Paleta CLARA (blanco/azul). Mismas claves que Palette.Dark.xaml. Contraste de texto principal ≥ 12:1 y
      secundario ≥ 4.5:1 sobre el fondo.
    -->
    <Color x:Key="BgColor">#F3F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceHiColor">#E8EEF6</Color>
    <Color x:Key="BorderColor">#D2DBE6</Color>
    <Color x:Key="TextColor">#10151C</Color>
    <Color x:Key="TextDimColor">#566273</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHiColor">#1D4ED8</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="DangerBgColor">#FCE8E8</Color>
    <Color x:Key="WarnColor">#B45309</Color>
    <Color x:Key="WarnBgColor">#FBF0DC</Color>
    <Color x:Key="OnlineColor">#15A34A</Color>
    <Color x:Key="OfflineColor">#94A3B8</Color>
    <Color x:Key="BubbleOutColor">#D8E7FE</Color>
    <Color x:Key="BubbleInColor">#EDF1F7</Color>
    <Color x:Key="ScrollThumbColor">#44000000</Color>
</ResourceDictionary>
