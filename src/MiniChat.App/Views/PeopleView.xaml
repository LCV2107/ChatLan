<UserControl x:Class="MiniChat.App.Views.PeopleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Punto de disponibilidad -->
        <DataTemplate x:Key="Dot">
            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{StaticResource Offline}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Online}" Value="True">
                                <Setter Property="Fill" Value="{StaticResource Online}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </DataTemplate>

        <DataTemplate x:Key="PersonHeader">
            <StackPanel>
                <DockPanel>
                    <ContentControl DockPanel.Dock="Left" ContentTemplate="{StaticResource Dot}" Content="{Binding}" Focusable="False"/>
                    <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="8" Padding="6,0"
                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Unread}" Foreground="#0E1513" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="14,1,0,0">
                    <Run Text="{Binding Machine, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding AvailabilityText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RelationText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="14,3,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Message}"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,4,0">

            <!-- Solicitudes -->
            <TextBlock Text="SOLICITUDES" Style="{StaticResource SectionTitle}" Visibility="{Binding HasRequests, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Requests}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PersonHeader}" Focusable="False"/>
                                <Border Background="{StaticResource SurfaceHi}" CornerRadius="5" Padding="8,5" Margin="0,7,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Dim}" Text="Código de emparejamiento (compárenlo por teléfono o en persona):" TextWrapping="Wrap"/>
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding PairingCode, Mode=OneWay}" FontFamily="Consolas" FontSize="14" Margin="0,2,0,0"
                                                 AutomationProperties.Name="Código de emparejamiento"/>
                                    </StackPanel>
                                </Border>
                                <WrapPanel Margin="0,7,0,0" Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Aceptar" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                                            Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Rechazar" Margin="0,0,6,0"
                                            Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button Content="Bloquear" Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,7,0,0" Visibility="{Binding IsOutgoing, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Dim}" Text="Esperando respuesta…" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Content="Cancelar solicitud"
                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Contactos -->
            <TextBlock Text="CONTACTOS" Style="{StaticResource SectionTitle}" Visibility="{Binding HasContacts, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding Contacts}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Abrir" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Visibility="{Binding CanOpenChat, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="Abrir conversación"/>
                                    <Button Content="Solicitar" Margin="6,0,0,0" Visibility="{Binding CanRequest, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            ToolTip="Enviar una nueva solicitud de chat"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" Margin="2,0,0,0" ToolTip="Más opciones" AutomationProperties.Name="Más opciones"
                                            Click="OnMoreClick">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Bloquear" Visibility="{Binding IsBlocked, Converter={StaticResource NotVis}}"
                                                          Command="{Binding PlacementTarget.Tag.BlockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Desbloquear (no autoriza de nuevo)" Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"
                                                          Command="{Binding PlacementTarget.Tag.UnblockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="{Binding PairingCode}" HeaderStringFormat="Código de emparejamiento: {0}" IsEnabled="False"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Tag>
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </Button.Tag>
                                    </Button>
                                </StackPanel>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PersonHeader}" Focusable="False"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Disponibles en la red -->
            <TextBlock Text="DISPONIBLES EN LA RED" Style="{StaticResource SectionTitle}"/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Text="{Binding NetworkHint}" Margin="2,0,0,6"
                       Visibility="{Binding HasAvailable, Converter={StaticResource NotVis}}"/>
            <ItemsControl ItemsSource="{Binding Available}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Solicitar chat" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top"
                                            Visibility="{Binding CanRequest, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PersonHeader}" Focusable="False"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Dim}" Text="{Binding ShortId}" Margin="14,2,0,0" ToolTip="Identificador abreviado de su clave"/>
                                <TextBlock Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="14,4,0,0" Text="{Binding IdentityWarning}"
                                           Visibility="{Binding HasIdentityWarning, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="14,4,0,0"
                                           Text="Usa una versión de MiniChat incompatible con la tuya."
                                           Visibility="{Binding IncompatibleVersion, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Conexión manual -->
            <Expander Margin="0,10,0,0" Foreground="{StaticResource Text}">
                <Expander.Header>
                    <TextBlock Text="Conectar por IP (si no aparece en la lista)" Style="{StaticResource Dim}" FontSize="12.5"/>
                </Expander.Header>
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                               Text="Pide a tu compañero su IP (Ajustes › IP local). Debe estar en tu misma red local; no funciona entre VLAN, subredes distintas o redes Wi-Fi con aislamiento de clientes."/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Conectar" Margin="6,0,0,0" Command="{Binding ConnectIpCommand}"/>
                        <TextBox Text="{Binding ManualIp, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="IP del compañero"
                                 ToolTip="Ejemplo: 192.168.1.25 o 192.168.1.25:47821">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding ConnectIpCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="{Binding ManualResult}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"
                               Visibility="{Binding HasManualResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ManualIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
