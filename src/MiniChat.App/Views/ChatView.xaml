<UserControl x:Class="MiniChat.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Sin conversación abierta -->
        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="20" FontSize="12.5"
                   Text="Abre una conversación desde Personas. Solo puedes escribir a quien haya aceptado tu solicitud (o cuya solicitud hayas aceptado)."
                   Visibility="{Binding HasContact, Converter={StaticResource NotVis}}"/>

        <Grid Visibility="{Binding HasContact, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Compañero -->
            <DockPanel Grid.Row="0" Margin="0,2,0,4">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding BackCommand}" ToolTip="Volver a Personas" AutomationProperties.Name="Volver"/>
                <Button DockPanel.Dock="Right" x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="Opciones de la conversación"
                        AutomationProperties.Name="Opciones de la conversación" Click="OnMenuClick">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding PairingCode}" HeaderStringFormat="Código de emparejamiento: {0}" IsEnabled="False"/>
                            <Separator/>
                            <MenuItem Header="Probar conexión" Command="{Binding TestConnectionCommand}"/>
                            <Separator/>
                            <MenuItem Header="Exportar a texto (sin cifrar)…" Command="{Binding ExportCommand}"/>
                            <MenuItem Header="Borrar historial en este equipo…" Command="{Binding ClearCommand}"/>
                            <Separator/>
                            <MenuItem Header="Bloquear" Command="{Binding BlockCommand}" Visibility="{Binding IsBlocked, Converter={StaticResource NotVis}}"/>
                            <MenuItem Header="Desbloquear" Command="{Binding UnblockCommand}" Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="2,0,0,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Offline}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Online}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Online}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding AvailabilityText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Machine, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Avisos -->
            <StackPanel Grid.Row="1">
                <Border Background="{StaticResource SurfaceHi}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4"
                        Visibility="{Binding HasRelationBanner, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding RelationBanner}" TextWrapping="Wrap" FontSize="12"/>
                        <WrapPanel Margin="0,5,0,0">
                            <Button Content="Enviar solicitud" Command="{Binding RequestCommand}" Margin="0,0,6,0" Visibility="{Binding CanRequest, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Desbloquear" Command="{Binding UnblockCommand}" Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource WarnBg}" CornerRadius="6" Padding="8,5" Margin="0,0,0,4" Visibility="{Binding HasUndelivered, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reintentar" Command="{Binding RetryCommand}"
                                ToolTip="Reenvía en orden los mensajes no entregados. Si alguno ya había llegado, no se duplica."/>
                        <TextBlock Text="{Binding UndeliveredText}" Foreground="{StaticResource Warn}" VerticalAlignment="Center" FontSize="12"/>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="2,0,0,4"
                           Visibility="{Binding HasActionMessage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Historial -->
            <Grid Grid.Row="2">
                <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" Style="{StaticResource PlainList}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         AutomationProperties.Name="Historial de mensajes">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Border x:Name="Bubble" CornerRadius="9" Padding="9,6" MaxWidth="280" HorizontalAlignment="Left" Background="{StaticResource BubbleIn}">
                                    <StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                                                 Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}"/>
                                        <Grid Visibility="{Binding IsSticker, Converter={StaticResource BoolToVis}}" MinWidth="40" MinHeight="40">
                                            <Image Source="{Binding StickerImage}" MaxWidth="140" MaxHeight="140" Stretch="Uniform" StretchDirection="DownOnly"
                                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Sticker"/>
                                            <TextBlock Text="[Sticker no disponible]" Style="{StaticResource Dim}"
                                                       Visibility="{Binding StickerMissing, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <!-- Documento adjunto -->
                                        <StackPanel Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" MinWidth="210">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="22" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" AutomationProperties.Name="Nombre del documento"/>
                                                    <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap">
                                                        <Run Text="{Binding FileSizeText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding FileStateText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,0" BorderThickness="0"
                                                         Background="{StaticResource SurfaceHi}" Foreground="{StaticResource AccentHi}"
                                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Foreground="{StaticResource Warn}" FontSize="11.5" TextWrapping="Wrap" Margin="0,5,0,0"
                                                       Visibility="{Binding IsDangerousFile, Converter={StaticResource BoolToVis}}"
                                                       Text="&#x26A0; Ejecutable, script o documento con macros: ábralo solo si lo esperaba y confía en quien lo envía."/>
                                            <TextBlock Text="{Binding FileError}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasFileError, Converter={StaticResource BoolToVis}}"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="Aceptar" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Padding="8,3"
                                                        Command="{Binding DataContext.AcceptFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanAcceptFile, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Rechazar" Margin="0,0,6,0" Padding="8,3"
                                                        Command="{Binding DataContext.RejectFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRejectFile, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Cancelar envío" Margin="0,0,6,0" Padding="8,3"
                                                        Command="{Binding DataContext.CancelFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanCancelFile, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Abrir" Margin="0,0,6,0" Padding="8,3"
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Guardar como…" Padding="8,3"
                                                        Command="{Binding DataContext.SaveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVis}}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0" ToolTip="{Binding ToolTipText}">
                                            <TextBlock Text="{Binding Time}" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding IsProblem, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BubbleOut}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSticker}" Value="True">
                                    <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFile}" Value="True">
                                    <!-- En documentos el estado se muestra dentro del bloque (oferta y transferencia). -->
                                    <Setter TargetName="StatusLabel" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="NewMessagesButton" Content="Nuevos mensajes ↓" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="OnJumpToEnd" AutomationProperties.Name="Ir al final"/>
            </Grid>

            <!-- Escritura -->
            <StackPanel Grid.Row="3" Margin="0,6,0,0">
                <DockPanel IsEnabled="{Binding CanWrite}">
                    <Button x:Name="StickerButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE76E;" FontSize="16"
                            Command="{Binding TogglePickerCommand}" ToolTip="Stickers" AutomationProperties.Name="Stickers" VerticalAlignment="Bottom"/>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE723;" FontSize="16"
                            Command="{Binding AttachCommand}" ToolTip="Enviar un documento (máx. 100 MB)" AutomationProperties.Name="Adjuntar documento" VerticalAlignment="Bottom"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="&#xE724;" FontFamily="{StaticResource IconFont}"
                            Command="{Binding SendCommand}" ToolTip="Enviar (Enter). Mayús+Enter: nueva línea" AutomationProperties.Name="Enviar"
                            VerticalAlignment="Bottom" Margin="6,0,0,0" Padding="10,7"/>
                    <TextBox x:Name="InputBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MaxHeight="110" MaxLength="4000" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                             PreviewKeyDown="OnInputKeyDown" AutomationProperties.Name="Escribir mensaje"/>
                </DockPanel>
                <TextBlock Text="{Binding InputError}" Style="{StaticResource ErrorText}" Margin="2,4,0,0"
                           Visibility="{Binding HasInputError, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Selector de stickers -->
            <Popup x:Name="StickerPopup" Grid.Row="3" IsOpen="{Binding IsPickerOpen}" PlacementTarget="{Binding ElementName=StickerButton}" Placement="Top" StaysOpen="False"
                   AllowsTransparency="True" Width="320">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Importar…" Command="{Binding ImportCommand}"
                                    ToolTip="PNG, JPG o WebP de tu equipo (hasta 5 MB y 4096×4096). Se convierten a PNG de hasta 512 px."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource LinkButton}" Content="Todos" Command="{Binding PickerTabCommand}" CommandParameter="Todos"/>
                                <Button Style="{StaticResource LinkButton}" Content="Favoritos" Command="{Binding PickerTabCommand}" CommandParameter="Favoritos" Margin="6,0"/>
                                <Button Style="{StaticResource LinkButton}" Content="Recientes" Command="{Binding PickerTabCommand}" CommandParameter="Recientes"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding PickerTab}" Style="{StaticResource Dim}" Margin="2,4,0,4"/>
                        <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="2,4" Text="No hay stickers aquí. Usa «Importar…» para añadir imágenes que ya tengas."
                                   Visibility="{Binding StickersEmpty, Converter={StaticResource BoolToVis}}"/>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Stickers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Button Width="64" Height="64" Padding="3" Background="{StaticResource SurfaceHi}" ToolTip="{Binding Name}"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.SendStickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly"/>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Favorito (marcar/desmarcar)" Command="{Binding PlacementTarget.Tag.FavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Quitar de la biblioteca" Command="{Binding PlacementTarget.Tag.RemoveStickerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Tag>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                </Button.Tag>
                                            </Button>
                                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Warn}" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0" IsHitTestVisible="False"
                                                       Visibility="{Binding Favorite, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{Binding PickerMessage}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Visibility="{Binding HasPickerMessage, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Style="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Text="Clic derecho sobre un sticker: favorito o quitar. Los animados se importan solo con su primer fotograma."/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
