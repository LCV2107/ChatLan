<UserControl x:Class="MiniChat.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="8,12,8,8">
            <TextBlock Text="Bienvenido a MiniChat LAN" FontSize="18" FontWeight="SemiBold"
                       Visibility="{Binding OnboardingPinOnly, Converter={StaticResource NotVis}}"/>
            <TextBlock Text="Proteja su historial con un PIN" FontSize="18" FontWeight="SemiBold"
                       Visibility="{Binding OnboardingPinOnly, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5"
                       Visibility="{Binding OnboardingPinOnly, Converter={StaticResource NotVis}}"
                       Text="Chatea con compañeros conectados a esta misma red local, sin Internet, sin cuentas y sin servidor central. Nadie puede escribirte hasta que aceptes su solicitud."/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5"
                       Visibility="{Binding OnboardingPinOnly, Converter={StaticResource BoolToVis}}"
                       Text="Esta versión guarda sus conversaciones cifradas. Al crear el PIN se cifrará también el historial que ya tenía."/>

            <StackPanel Visibility="{Binding OnboardingPinOnly, Converter={StaticResource NotVis}}">
                <TextBlock Text="¿Cómo quieres que te vean tus compañeros?" Margin="0,16,0,6"/>
                <TextBox x:Name="NameBox" Text="{Binding OnboardingName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                         AutomationProperties.Name="Nombre visible"/>
                <TextBlock Style="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap">
                    <Run Text="Nombre de este equipo: "/><Run Text="{Binding MachineName, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=". Se mostrará junto a tu nombre para que tus compañeros sepan qué PC usas."/>
                </TextBlock>
            </StackPanel>

            <TextBlock Margin="0,16,0,6" TextWrapping="Wrap">
                <Run Text="PIN para abrir tus conversaciones (mínimo "/><Run Text="{Binding MinPinLength, Mode=OneWay}"/><Run Text=" caracteres)"/>
            </TextBlock>
            <PasswordBox x:Name="PinBox" AutomationProperties.Name="PIN" MaxLength="64"/>
            <TextBlock Text="Repite el PIN" Margin="0,8,0,6"/>
            <PasswordBox x:Name="PinConfirmBox" AutomationProperties.Name="Repetir PIN" MaxLength="64" KeyDown="OnPinKeyDown"/>
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="El PIN y tu cuenta de Windows protegen el historial guardado en este equipo. Si lo olvidas, el historial no se podrá recuperar (tus contactos se conservan)."/>
            <TextBlock Text="{Binding OnboardingError}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"/>
            <Button x:Name="ContinueButton" Content="Continuar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0"
                    Click="OnContinue" IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
