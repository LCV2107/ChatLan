<Application x:Class="MiniChat.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:MiniChat.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Paleta por defecto (oscura). App.xaml.cs la cambia al arrancar según el ajuste/sistema. -->
                <ResourceDictionary Source="Themes/Palette.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <inf:InverseBoolToVisibilityConverter x:Key="NotVis"/>
            <inf:InverseBoolConverter x:Key="Not"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
